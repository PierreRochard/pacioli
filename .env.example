# For an externally managed database, copy to .env, replace secrets, and source it.
# The local `make db-init` workflow creates private .local/config.json instead.
pacioli_ENV=Dev
SECRET_KEY=replace-with-a-random-secret
SECURITY_PASSWORD_SALT=replace-with-another-random-secret
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=replace-with-mail-password
PACIOLI_CREDENTIAL_KEY=replace-with-a-fernet-key
PGUSER=pacioli
PGPASSWORD=replace-with-postgres-password
PGHOST=localhost
PGPORT=5432
# Optional: DATABASE_URL replaces the PG* connection settings.
# Optional: PACIOLI_BACKUP_DIR chooses where backup files are staged.
