{
  "manifest_version": 2,
  "name": "Pacioli Local Chase Connector",
  "version": "0.2.0",
  "description": "On-demand local QFX collection for Pacioli using an explicitly selected Chase tab.",
  "browser_specific_settings": {"gecko": {"id": "chase-local@pacioli.lan", "strict_min_version": "126.0"}},
  "permissions": ["activeTab", "nativeMessaging", "downloads", "webRequest", "https://secure.chase.com/*", "https://www.chase.com/*", "https://chase.com/*"],
  "background": {"scripts": ["background.js"]},
  "browser_action": {"default_title": "Use this Chase tab with Pacioli"},
  "content_security_policy": "script-src 'self'; object-src 'none'; connect-src 'none'"
}
