{
  "manifest_version": 2,
  "name": "Pacioli Local Schwab Connector",
  "version": "0.2.0",
  "description": "On-demand local export collection for Pacioli using an explicitly selected Schwab tab.",
  "browser_specific_settings": {
    "gecko": {
      "id": "schwab-local@pacioli.lan",
      "strict_min_version": "126.0"
    }
  },
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "downloads",
    "webRequest",
    "<all_urls>",
    "https://client.schwab.com/*",
    "https://www.schwab.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_action": {
    "default_title": "Use this Schwab tab with Pacioli"
  },
  "content_security_policy": "script-src 'self'; object-src 'none'; connect-src 'none'"
}
